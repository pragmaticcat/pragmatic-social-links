{% import '_includes/forms' as forms %}

{% set rows = value.all() %}
{% set networkMapJson = socialNetworkMap|json_encode(constant('JSON_UNESCAPED_SLASHES')) %}

{% css %}
  .psl-field {
    display: grid;
    gap: 12px;
  }
  .psl-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid #d7dde5;
    border-radius: 10px;
    overflow: hidden;
    background: #fff;
  }
  .psl-table thead th {
    padding: 10px 12px;
    background: #f7f9fc;
    border-bottom: 1px solid #d7dde5;
    font-size: 12px;
    font-weight: 700;
    color: #445266;
  }
  .psl-table tbody td {
    padding: 10px 12px;
    border-bottom: 1px solid #edf1f5;
    vertical-align: middle;
  }
  .psl-table tbody tr:last-child td {
    border-bottom: 0;
  }
  .psl-table tbody tr.psl-dragging {
    opacity: .45;
  }
  .psl-handle,
  .psl-remove {
    width: 42px;
    text-align: center;
    white-space: nowrap;
  }
  .psl-drag {
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #596579;
    cursor: grab;
    font-size: 16px;
  }
  .psl-empty {
    padding: 24px 16px;
    color: #66768a;
    text-align: center;
  }
  .psl-network-preview {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    color: #66768a;
    font-size: 12px;
  }
  .psl-network-preview svg {
    width: 16px;
    height: 16px;
  }
  .psl-add {
    justify-self: start;
  }
{% endcss %}

<div
  id="{{ namespacedId }}"
  class="psl-field"
  data-social-links-field
  data-empty-text="{{ 'No social links yet. Add the first row below.'|t('pragmatic-social-links')|e('html_attr') }}"
>
  <table class="psl-table">
    <thead>
      <tr>
        <th class="psl-handle"></th>
        <th>{{ 'Social network'|t('pragmatic-social-links') }}</th>
        <th>{{ 'URL'|t('pragmatic-social-links') }}</th>
        <th class="psl-remove"></th>
      </tr>
    </thead>
    <tbody data-rows>
      {% if rows %}
        {% for row in rows %}
          <tr data-row draggable="true">
            <td class="psl-handle">
              <button type="button" class="psl-drag" title="{{ 'Reorder'|t('pragmatic-social-links') }}">⋮⋮</button>
            </td>
            <td>
              <select class="select" name="{{ field.handle }}[{{ loop.index0 }}][network]" data-network-select>
                <option value="">{{ 'Select a social network'|t('pragmatic-social-links') }}</option>
                {% for option in socialNetworks %}
                  <option value="{{ option.value }}" {{ option.value == row.network ? 'selected' }}>{{ option.label }}</option>
                {% endfor %}
              </select>
              <div class="psl-network-preview" data-network-preview>
                {% set network = socialNetworkMap|filter(item => item.handle == row.network)|first %}
                {% if network %}
                  {{ network.icon|raw }}
                  <span>{{ network.label }}</span>
                {% endif %}
              </div>
            </td>
            <td>
              <input class="text fullwidth" type="url" name="{{ field.handle }}[{{ loop.index0 }}][url]" value="{{ row.url }}" placeholder="https://..." />
            </td>
            <td class="psl-remove">
              <button type="button" class="btn" data-remove-row>{{ 'Delete'|t('site') }}</button>
            </td>
          </tr>
        {% endfor %}
      {% else %}
        <tr data-empty-state>
          <td colspan="4" class="psl-empty">{{ 'No social links yet. Add the first row below.'|t('pragmatic-social-links') }}</td>
        </tr>
      {% endif %}
    </tbody>
  </table>

  <button type="button" class="btn add icon psl-add" data-add-row>{{ 'Add social link'|t('pragmatic-social-links') }}</button>

  <template data-row-template>
    <tr data-row draggable="true">
      <td class="psl-handle">
        <button type="button" class="psl-drag" title="{{ 'Reorder'|t('pragmatic-social-links') }}">⋮⋮</button>
      </td>
      <td>
        <select class="select" name="{{ field.handle }}[__INDEX__][network]" data-network-select>
          <option value="">{{ 'Select a social network'|t('pragmatic-social-links') }}</option>
          {% for option in socialNetworks %}
            <option value="{{ option.value }}">{{ option.label }}</option>
          {% endfor %}
        </select>
        <div class="psl-network-preview" data-network-preview></div>
      </td>
      <td>
        <input class="text fullwidth" type="url" name="{{ field.handle }}[__INDEX__][url]" placeholder="https://..." />
      </td>
      <td class="psl-remove">
        <button type="button" class="btn" data-remove-row>{{ 'Delete'|t('site') }}</button>
      </td>
    </tr>
  </template>

  <script type="application/json" data-network-map-json>{{ networkMapJson|raw }}</script>
</div>
